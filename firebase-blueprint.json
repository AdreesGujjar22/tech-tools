{
  "entities": {
    "blog": {
      "title": "Blog Post",
      "description": "A blog post document in the system",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the post" },
        "slug": { "type": "string", "description": "SEO-friendly URL slug" },
        "content": { "type": "string", "description": "HTML content from Jodit Editor" },
        "excerpt": { "type": "string", "description": "Brief summary of the post" },
        "category": { "type": "string", "description": "Category name or slug" },
        "tags": { "type": "array", "description": "List of tags associated" },
        "featuredImage": { "type": "string", "description": "URL of the featured image" },
        "status": { "type": "string", "enum": ["draft", "published"], "description": "Publish status" },
        "readingTime": { "type": "string", "description": "Estimated reading time" },
        "publishedAt": { "type": "string", "format": "date-time", "description": "Timestamp when published" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when created" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp when last updated" },
        "seoTitle": { "type": "string", "description": "SEO meta title override" },
        "seoDescription": { "type": "string", "description": "SEO meta description override" },
        "seoKeywords": { "type": "string", "description": "Comma-separated keywords" }
      },
      "required": ["title", "slug", "content", "status", "createdAt", "updatedAt"]
    },
    "category": {
      "title": "Category",
      "description": "Category for classifying blogs",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of category" },
        "slug": { "type": "string", "description": "URL slug of category" }
      },
      "required": ["name", "slug"]
    },
    "tag": {
      "title": "Tag",
      "description": "Tag for tagging blogs",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of tag" },
        "slug": { "type": "string", "description": "URL slug of tag" }
      },
      "required": ["name", "slug"]
    },
    "pdf_tool_setting": {
      "title": "PDF Tool Setting",
      "description": "Enabling/disabling settings for each PDF tool",
      "type": "object",
      "properties": {
        "toolId": { "type": "string", "description": "Unique identifier of the PDF tool" },
        "enabled": { "type": "boolean", "description": "Whether the tool is enabled and functional" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp when this setting was last updated" }
      },
      "required": ["toolId", "enabled", "updatedAt"]
    },
    "pdf_tool_analytic": {
      "title": "PDF Tool Analytic",
      "description": "Usage analytics log for PDF tool executions",
      "type": "object",
      "properties": {
        "toolId": { "type": "string", "description": "The PDF tool that was executed" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the operation occurred" },
        "fileName": { "type": "string", "description": "Sanitized filename of processed paper" },
        "fileSize": { "type": "number", "description": "Size in bytes" },
        "success": { "type": "boolean", "description": "Whether the processing succeeded" },
        "errorMessage": { "type": "string", "description": "Optional error logging details" }
      },
      "required": ["toolId", "timestamp", "fileName", "fileSize", "success"]
    },
    "image_tool_setting": {
      "title": "Image Tool Setting",
      "description": "Enabling/disabling settings for each Image tool",
      "type": "object",
      "properties": {
        "toolId": { "type": "string", "description": "Unique identifier of the Image tool" },
        "enabled": { "type": "boolean", "description": "Whether the tool is enabled and functional" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp when this setting was last updated" }
      },
      "required": ["toolId", "enabled", "updatedAt"]
    },
    "image_tool_analytic": {
      "title": "Image Tool Analytic",
      "description": "Usage analytics log for Image tool executions",
      "type": "object",
      "properties": {
        "toolId": { "type": "string", "description": "The Image tool that was executed" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the operation occurred" },
        "fileName": { "type": "string", "description": "Sanitized filename of processed image" },
        "fileSize": { "type": "number", "description": "Size in bytes" },
        "success": { "type": "boolean", "description": "Whether the processing succeeded" },
        "errorMessage": { "type": "string", "description": "Optional error logging details" }
      },
      "required": ["toolId", "timestamp", "fileName", "fileSize", "success"]
    }
  },
  "firestore": {
    "/blogs/{blogId}": {
      "schema": "blog",
      "description": "Collection of all blog posts"
    },
    "/categories/{categoryId}": {
      "schema": "category",
      "description": "Collection of blog categories"
    },
    "/tags/{tagId}": {
      "schema": "tag",
      "description": "Collection of blog tags"
    },
    "/pdf_tools_settings/{settingId}": {
      "schema": "pdf_tool_setting",
      "description": "Settings collection to toggle availability of individual PDF tools"
    },
    "/pdf_tool_analytics/{analyticId}": {
      "schema": "pdf_tool_analytic",
      "description": "Collection storing non-PII execution metadata for tool telemetry"
    },
    "/image_tools_settings/{settingId}": {
      "schema": "image_tool_setting",
      "description": "Settings collection to toggle availability of individual Image tools"
    },
    "/image_tool_analytics/{analyticId}": {
      "schema": "image_tool_analytic",
      "description": "Collection storing non-PII execution metadata for image tool telemetry"
    }
  }
}
